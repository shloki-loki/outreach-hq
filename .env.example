# Copy to .env (ignored by git). Only needed on this Mac for local runs; GitHub Actions uses repo secrets.

# Gmail: a Google App Password (not your normal password). myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional free-tier email finders and verifiers. Each one you add lowers the bounce rate.
HUNTER_API_KEY=       # hunter.io: free finder + verifier credits each month
QEV_API_KEY=          # quickemailverification.com: free daily verification credits
REOON_API_KEY=        # reoon.com email verifier: free daily credits
APOLLO_API_KEY=       # apollo.io: free plan; its API may refuse some calls on free

# Used in the digest email for links back to the site.
SITE_URL=
