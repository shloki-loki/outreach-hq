# Set these in Vercel > Project > Settings > Environment Variables (never commit real values).
SITE_PASSWORD=          # the password you type to open the site; make it long
GITHUB_TOKEN=           # fine-grained token for this repo only: Contents read/write, Actions read/write
GITHUB_REPO=shloki-loki/outreach-hq
DATA_BRANCH=data
